# Backend environment variables — copy to .env (dev) or set on Render (prod)

# Required in production (any random 50-char string; never commit a real one)
SECRET_KEY=django-insecure-change-me-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (Render auto-injects RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of allowed CORS origins (your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://eld-trip-planner.vercel.app

# Optional: override the free public APIs (e.g. self-hosted OSRM)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
